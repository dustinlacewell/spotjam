{
  "compilerOptions": {
    "target": "ES2022",
    // This package runs in both the browser (via Vite) and Node (the server),
    // so it leans only on globals common to both: TextEncoder, crypto.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
