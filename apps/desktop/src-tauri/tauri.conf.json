{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spotjam",
  "version": "0.3.1",
  "identifier": "com.dustin.spotjam",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "spotjam",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://peering.ldlework.com/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzREUwMjMwQ0I1MjEwMTMKUldRVEVGTExNQUxlazBXM3FYZ3JIbm1FT0NCM2lldko2WUNZeXcvbnV4czhLWmtlRWRkVzNFZ3gK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
